-- Main RoChess logic (simplified for integration)
local function analyzeVortexBot(fen, depth, token)
    if not (type(bot.buildEngine) == "function" and type(bot.Search) == "table" and type(bot.Search.new) == "function") then return nil end
    local okPos, position = pcall(function() return bot.buildEngine(fen, {}) end)
    if not okPos or type(position) ~= "table" then return nil end
    local okSearch, search = pcall(function() return bot.Search.new(position) end)
    if not okSearch or type(search) ~= "table" or type(search.rootScores) ~= "function" then return nil end
    local scores = search:rootScores(math.clamp(math.floor(depth), 2, 18))
    if type(scores) ~= "table" or #scores == 0 then return nil end
    table.sort(scores, function(a, b) return (tonumber(a.score) or 0) > (tonumber(b.score) or 0) end)
    local moves = {}
    for i = 1, math.min(2, #scores) do
        table.insert(moves, { uci = position:moveToUci(scores[i].move), score = scores[i].score })
    end
    return moves
end

-- VE Chess Logic
local originalThink = VortexBot.think
VortexBot.think = function(startFen, moves, persona, opts)
    local uci, info = originalThink(startFen, moves, persona, opts)
    pcall(function()
        local session = App.session
        if session and session.kind == "bot" and session.bot and type(persona) == "table" and persona.id == session.bot and type(uci) == "string" then
            VE.state.decision = { session = session, ply = #session.ucis, uci = uci, info = info, at = os.clock() }
        end
    end)
    return uci, info
end

local function formatClock(ms)
    ms = math.max(0, tonumber(ms) or 0)
    local total = math.floor(ms / 1000)
    return string.format("%d:%02d", math.floor(total / 60), total % 60)
end

local function updateVE()
    local session = App.session
    if not session then return end
    
    -- Enemy View
    if VE.config.EnemyView then
        local ply = #session.ucis
        local enemyWhite = session.myColor ~= 1
        local enemySide = enemyWhite and session.white or session.black
        local enemyName = (enemySide and (enemySide.display or enemySide.name)) or (enemyWhite and "White" or "Black")
        
        local clock = 0
        pcall(function() clock = session:clockFor(enemyWhite and 1 or -1, workspace:GetServerTimeNow()) end)
        
        local lastLine = "no moves yet"
        if ply > 0 then
            lastLine = session.sans[ply] or "?"
        end
        
        local planLine = "waiting for their turn"
        local decision = VE.state.decision
        if decision and decision.session == session and decision.ply == ply and decision.uci then
            planLine = "wants " .. decision.uci
        end
        
        VE.state.enemyLine1 = string.format("%s (%s)", enemyName, formatClock(clock))
        VE.state.enemyLine2 = "last move: " .. lastLine
        VE.state.enemyLine3 = planLine
    else
        VE.state.enemyLine1 = "Enemy View Off"
        VE.state.enemyLine2 = ""
        VE.state.enemyLine3 = ""
    end
    
    -- Update UI Text
    if textRefs["EnemyLine1"] then
        textRefs["EnemyLine1"].Text = VE.state.enemyLine1
        textRefs["EnemyLine2"].Text = VE.state.enemyLine2
        textRefs["EnemyLine3"].Text = VE.state.enemyLine3
        textRefs["VE_Status"].Text = session:isMyTurn() and "Status: Your Turn" or "Status: Their Turn"
    end
end

-- Main Loop
RunService.RenderStepped:Connect(function()
    pcall(updateVE)
end)

