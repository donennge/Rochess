----------------------------------------------------------------------
-- CONFIG SAVE/LOAD
----------------------------------------------------------------------
local function ensureDir()
    if type(makefolder) == "function" and type(isfolder) == "function" then
        if not isfolder(config_dir) then makefolder(config_dir) end
    end
end

local function listConfigs()
    ensureDir()
    local list = {}
    if type(listfiles) == "function" then
        local files = listfiles(config_dir)
        if type(files) == "table" then
            for _, f in ipairs(files) do
                local name = string.match(f, "[^/\\]+$")
                if name then
                    name = string.match(name, "^(.+)%.json$")
                    if name and name ~= "" then table.insert(list, name) end
                end
            end
        end
    end
    table.sort(list); return list
end

local function saveConfig(name, data)
    ensureDir()
    if type(writefile) ~= "function" then return false end
    writefile(config_dir .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    return true
end

local function loadConfig(name)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    local path = config_dir .. "/" .. name .. ".json"
    if not isfile(path) then return nil end
    local content = readfile(path)
    if type(content) ~= "string" then return nil end
    local okDec, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDec or type(data) ~= "table" then return nil end
    return data
end

local function deleteConfig(name)
    if type(delfile) == "function" then delfile(config_dir .. "/" .. name .. ".json") end
end

local function saveMeta()
    if type(writefile) ~= "function" then return end
    writefile(meta_file, HttpService:JSONEncode({ autoloadConfig = state.autoloadConfig, currentConfig = state.currentConfig }))
end

local function loadMeta()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    if not isfile(meta_file) then return end
    local content = readfile(meta_file)
    if type(content) ~= "string" then return end
    local okDec, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDec or type(data) ~= "table" then return end
    if type(data.autoloadConfig) == "boolean" then state.autoloadConfig = data.autoloadConfig end
    if type(data.currentConfig) == "string" then state.currentConfig = data.currentConfig end
end

local function applyConfigData(data)
    if type(data) ~= "table" then return end
    if type(data.autoPlay) == "boolean" then state.autoPlay = data.autoPlay end
    if type(data.model) == "string" then state.model = data.model:lower() end
    if type(data.autoPlayChoice) == "string" then state.autoPlayChoice = data.autoPlayChoice:lower() end
    if type(data.playDelay) == "number" then state.playDelay = math.clamp(data.playDelay, 0.1, 2) end
    if type(data.depth) == "number" then state.depth = math.clamp(math.floor(data.depth), 4, 24) end
    if type(data.showBest) == "boolean" then state.showBest = data.showBest end
    if type(data.showSecond) == "boolean" then state.showSecond = data.showSecond end
end

local function getCurrentConfigData()
    return {
        autoPlay = state.autoPlay, model = state.model, playDelay = state.playDelay,
        depth = state.depth, autoPlayChoice = state.autoPlayChoice,
        showBest = state.showBest, showSecond = state.showSecond
    }
end

loadMeta()
if state.autoloadConfig and state.currentConfig ~= "" then
    local data = loadConfig(state.currentConfig)
    if data then applyConfigData(data) end
end
state.model = state.model:lower()
if state.model == "lichess" then state.model = "chess api" end

