----------------------------------------------------------------------
-- ROCHESS BACKEND (YUA'S LOGIC)
----------------------------------------------------------------------
local function invalidateAnalysis(clearSecondBest)
    state.best = nil
    if clearSecondBest then state.secondBest = nil end
    state.lastAutoFen = nil; state.lastFailFen = nil
end

local function isController(value)
    if type(value) ~= "table" then return false end
    local board = value.board
    if type(board) ~= "table" then return false end
    if type(value.render) ~= "function" or type(value.onBoardMove) ~= "function" or type(value.setSession) ~= "function" then return false end
    return type(board.setTint) == "function" and type(board.setArrow) == "function"
end

local function getUpvalueValues(fn)
    local values = {}
    if type(debug) == "table" and type(debug.getupvalues) == "function" then
        local ok, result = pcall(function() return debug.getupvalues(fn) end)
        if ok and type(result) == "table" then for _, v in pairs(result) do table.insert(values, v) end end
    end
    if #values == 0 and type(debug) == "table" and type(debug.getupvalue) == "function" then
        for i = 1, 60 do
            local ok, name, val = pcall(function() return debug.getupvalue(fn, i) end)
            if not ok or name == nil then break end
            table.insert(values, val ~= nil and val or name)
        end
    end
    return values
end

local function findController(force)
    if state.controller and isController(state.controller) then return state.controller end
    if not force and os.clock() - state.lastScan < 1 then return nil end
    state.lastScan = os.clock(); state.controller = nil; state.scanError = nil
    if type(getgc) ~= "function" then state.scanError = "executor doesnt expose getgc"; return nil end
    local objects = getgc(true)
    if type(objects) ~= "table" then objects = getgc() end
    if type(objects) ~= "table" then return nil end
    for _, obj in pairs(objects) do if isController(obj) then state.controller = obj; return obj end end
    for _, obj in pairs(objects) do
        if type(obj) == "function" then
            for _, upv in ipairs(getUpvalueValues(obj)) do
                if isController(upv) then state.controller = upv; return upv end
            end
        end
    end
    return nil
end

local function getPosition(app)
    if not app then return nil, nil end
    local session = app.session
    if type(session) ~= "table" then return nil, nil end
    if type(session.engine) ~= "table" or type(session.engine.getFen) ~= "function" then return session, nil end
    local fen = session.engine:getFen()
    if type(fen) ~= "string" or fen == "" then return session, nil end
    return session, fen, nil
end

local function currentFen(session)
    if not session or type(session.engine) ~= "table" then return nil end
    local fen = session.engine:getFen()
    if type(fen) == "string" then return fen end
    return nil
end

local function isMyTurn(session)
    if not session then return false end
    if type(session.isMyTurn) == "function" then
        local r = session:isMyTurn()
        if type(r) == "boolean" then return r end
    end
    local fen = currentFen(session)
    local side = fen and string.match(fen, "^[^ ]+%s+([wb])")
    local sideValue = side == "w" and 1 or side == "b" and -1 or nil
    return sideValue ~= nil and session.myColor ~= nil and sideValue == session.myColor
end

local function moveBlockReason(session)
    if not session then return true end
    if session.over then return true end
    if type(session.ucis) == "table" and type(session.viewPly) == "number" and session.viewPly < #session.ucis then return true end
    if not isMyTurn(session) then return true end
    return false
end

