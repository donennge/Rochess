local function isArrowIntact(app, name, fromIndex, toIndex, color)
    local board = app and app.board
    if not board then return false end
    local arrows = board.arrows
    if type(arrows) ~= "table" then return false end
    local existing = arrows[name]
    if type(existing) ~= "table" then return false end
    if existing.from ~= fromIndex or existing.to ~= toIndex or existing.color ~= color then return false end
    local parts = existing.parts
    if type(parts) ~= "table" or #parts == 0 or parts[1] == nil then return false end
    local p1 = parts[1]
    if typeof(p1) == "Instance" and p1.Parent == nil then return false end
    return true
end

local function drawArrow(app, name, uci, color)
    if not app or not app.board then return false end
    if type(uci) ~= "string" or #uci < 4 then return false end
    local fromIndex = engine.algToIndex64(string.sub(uci, 1, 2))
    local toIndex = engine.algToIndex64(string.sub(uci, 3, 4))
    if type(fromIndex) ~= "number" or type(toIndex) ~= "number" then return false end
    if isArrowIntact(app, name, fromIndex, toIndex, color) then return true end
    app.board:setTint(name, fromIndex, color, 0.35)
    app.board:setArrow(name, fromIndex, toIndex, color, 0.6)
    return true
end

local function analyzeVortexBot(fen, depth, token)
    if not (type(bot.buildEngine) == "function" and type(bot.Search) == "table" and type(bot.Search.new) == "function") then return nil end
    local okPos, position = pcall(function() return bot.buildEngine(fen, {}) end)
    if not okPos or type(position) ~= "table" or type(position.legalMoves) ~= "function" or type(position.moveToUci) ~= "function" then return nil end
    local okSearch, search = pcall(function() return bot.Search.new(position) end)
    if not okSearch or type(search) ~= "table" or type(search.rootScores) ~= "function" then return nil end
    local deadline = os.clock() + 0.5
    search.deadline = deadline; search.soft = deadline; search.slice = 0.004; search.sliceStart = os.clock()
    search.cancelled = function() return state.destroyed or token ~= state.analysisToken end
    search.multiPV = 2
    local scores, multiScores, completedDepth, multiDepth = nil, nil, 0, 0
    local maxDepth = math.clamp(math.floor(depth), 2, 18)
    for d = 1, maxDepth do
        if state.destroyed or token ~= state.analysisToken or os.clock() >= deadline then break end
        local okS, s = pcall(function() return search:rootScores(d) end)
        if not okS or type(s) ~= "table" or #s == 0 then break end
        scores = s; completedDepth = d
        if #s >= 2 then multiScores = s; multiDepth = d end
        if search.stop then break end
    end
    if type(multiScores) == "table" and #multiScores >= 2 then scores = multiScores; completedDepth = multiDepth end
    if type(scores) ~= "table" or #scores == 0 then return nil end
    table.sort(scores, function(a, b)
        local sa = tonumber(a and a.score) or 0; local sb = tonumber(b and b.score) or 0
        if sa == sb then return (a and a.move or 0) < (b and b.move or 0) end
        return sa > sb
    end)
    local moves, seen = {}, {}
    for i = 1, #scores do
        if #moves >= 2 then break end
        local uci = position:moveToUci(scores[i].move)
        if type(uci) == "string" and uci ~= "" and not seen[uci] then
            seen[uci] = true
            table.insert(moves, { uci = uci, score = tonumber(scores[i].score) or 0, depth = completedDepth, source = "vortex bot" })
        end
    end
    if #moves == 0 then return moves end
    return moves
end

local function analyzeChessApi(fen, token)
    local requestFn = request or http_request or (typeof(syn) == "table" and syn.request) or (typeof(http) == "table" and http.request)
    if type(requestFn) ~= "function" then return nil end
    local body = HttpService:JSONEncode({ fen = fen, depth = math.clamp(math.floor(state.depth), 1, 18), maxThinkingTime = 100, variants = 2 })
    local response
    for attempt = 1, 3 do
        if state.destroyed or token ~= state.analysisToken then return nil end
        local ok, resp = pcall(function() return requestFn({ Url = "https://chess-api.com/v1", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body, Timeout = 5 }) end)
        if ok and type(resp) == "table" and resp.StatusCode == 200 then response = resp; break end
        if attempt < 3 then task.wait(0.5) end
    end
    if not response then return nil end
    local okDec, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not okDec or type(data) ~= "table" then return nil end
    if type(data.move) ~= "string" or not string.match(data.move, "^[a-h][1-8][a-h][1-8][qrbn]?$") then return nil end
    local moves = { { uci = data.move, score = tonumber(data.score) or 0, depth = tonumber(data.depth) or 0, source = "chess api" } }
    if type(data.moveAlternatives) == "string" then
        for alt in string.gmatch(data.moveAlternatives, "[^,]+") do
            alt = string.gsub(alt, "^%s+", ""); alt = string.gsub(alt, "%s+$", "")
            if alt ~= data.move and string.match(alt, "^[a-h][1-8][a-h][1-8][qrbn]?$") then
                table.insert(moves, { uci = alt, score = 0, depth = 0, source = "chess api" })
                if #moves >= 2 then break end
            end
        end
    end
    return moves
end

local function analyzePosition(fen, token)
    local useChessApiFirst = state.model == "chess api"
    local first, firstErr = useChessApiFirst and analyzeChessApi(fen, token) or analyzeVortexBot(fen, state.depth, token)
    if first and #first >= 1 then return first end
    local second, secondErr = useChessApiFirst and analyzeVortexBot(fen, state.depth, token) or analyzeChessApi(fen, token)
    if second and #second >= 1 then return second end
    return nil, secondErr or firstErr
end

local function sendUciMove(app, session, fen, uci)
    if state.destroyed then return false end
    if not app or app.session ~= session then return false end
    if currentFen(session) ~= fen then return false end
    if moveBlockReason(session) then return false end
    if type(uci) ~= "string" or not string.match(uci, "^[a-h][1-8][a-h][1-8][qrbn]?$") then return false end
    local fromIndex = engine.algToIndex64(string.sub(uci, 1, 2))
    local toIndex = engine.algToIndex64(string.sub(uci, 3, 4))
    local promoLetter = string.sub(uci, 5, 5)
    local promoType = promotion_types[promoLetter]
    if type(fromIndex) ~= "number" or type(toIndex) ~= "number" then return false end
    local moveHandler = app.onBoardMove
    if type(moveHandler) ~= "function" then return false end
    local ok, response = pcall(function() return moveHandler(fromIndex, toIndex, promoType, false) end)
    if not ok or response == false then return false end
    return true
end

local function runAnalysis(app, session, fen, isForAutoplay)
    if state.destroyed or state.analysisBusy then return false end
    state.analysisBusy = true; state.analysisStartedAt = os.clock(); state.analysisToken += 1
    local token = state.analysisToken
    task.spawn(function()
        local ok, moves = pcall(function() return analyzePosition(fen, token) end)
        if token ~= state.analysisToken or state.destroyed then state.analysisBusy = false; return end
        state.analysisBusy = false
        if not ok then state.lastFailFen = fen; state.lastAutoFen = fen; return end
        pcall(function()
            if not moves or #moves == 0 then
                state.best = nil; state.secondBest = nil; state.lastFailFen = fen; state.lastAutoFen = fen; clearArrows(app); return
            end
            if not app or app.session ~= session or currentFen(session) ~= fen then return end
            state.lastFailFen = nil; state.best = { session = session, fen = fen, uci = moves[1].uci }
            if moves[2] then state.secondBest = { session = session, fen = fen, uci = moves[2].uci }
            else state.secondBest = nil; clearSecondArrow(app) end
            local myTurn = isMyTurn(session)
            if isForAutoplay and state.autoPlay and myTurn then
                if state.showBest then drawArrow(app, "best_arrow", state.best.uci, highlight_green) end
                if state.showSecond and state.secondBest then drawArrow(app, "second_best_arrow", state.secondBest.uci, highlight_blue) end
                task.wait(state.playDelay)
                if state.destroyed or token ~= state.analysisToken then return end
                if not state.autoPlay then return end
                if not app or app.session ~= session or currentFen(session) ~= fen then return end
                local chosen
                if state.autoPlayChoice == "second best" and state.secondBest then chosen = state.secondBest.uci
                else chosen = state.best.uci end
                sendUciMove(app, session, fen, chosen)
                state.lastAutoFen = fen
            elseif myTurn then
                if state.showBest then drawArrow(app, "best_arrow", state.best.uci, highlight_green) end
                if state.showSecond and state.secondBest then drawArrow(app, "second_best_arrow", state.secondBest.uci, highlight_blue) end
                state.lastAutoFen = fen
            end
        end)
    end)
    return true
end

local function startWorker()
    if state.workerRunning or state.destroyed then return end
    state.workerRunning = true
    task.spawn(function()
        while not state.destroyed and (state.autoPlay or state.showBest or state.showSecond) do
            pcall(function()
                if state.analysisBusy and os.clock() - state.analysisStartedAt > 20 then
                    state.analysisBusy = false; state.analysisToken += 1
                end
                local app = findController(false)
                if app then
                    local session, fen = getPosition(app)
                    if session then
                        if state.currentSession ~= session then
                            state.currentSession = session; state.lastAutoFen = nil; state.lastFailFen = nil; state.best = nil; state.secondBest = nil; clearArrows(app)
                        end
                        if state.showBest then
                            if state.best and state.best.session == session and state.best.fen == fen then drawArrow(app, "best_arrow", state.best.uci, highlight_green)
                            else clearBestArrow(app) end
                        end
                        if state.showSecond then
                            if state.secondBest and state.secondBest.session == session and state.secondBest.fen == fen then drawArrow(app, "second_best_arrow", state.secondBest.uci, highlight_blue)
                            else clearSecondArrow(app) end
                        end
                        if fen then
                            local myTurn = isMyTurn(session)
                            local hasCached = state.best and state.best.session == session and state.best.fen == fen
                            local canPlay = state.autoPlay and myTurn and not moveBlockReason(session)
                            local needsPlay = canPlay and state.lastAutoFen ~= fen and state.lastFailFen ~= fen
                            local canShowArrow = (state.showBest or state.showSecond) and myTurn and not state.autoPlay
                            local needsAnalyzeForArrow = canShowArrow and not hasCached and state.lastFailFen ~= fen
                            if not state.analysisBusy and (needsPlay or needsAnalyzeForArrow) then
                                if needsPlay then state.lastAutoFen = fen; runAnalysis(app, session, fen, true)
                                else runAnalysis(app, session, fen, false) end
                            end
                        end
                    end
                end
            end)
            task.wait(0.05)
        end
        state.workerRunning = false
        if not state.destroyed and (state.autoPlay or state.showBest or state.showSecond) then startWorker() end
    end)
end

