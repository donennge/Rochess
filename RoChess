    app = app or state.controller
    if not app or not app.board then return end
    app.board:setTint("best_arrow", nil); app.board:setArrow("best_arrow", nil)
    app.board:setTint("second_best_arrow", nil); app.board:setArrow("second_best_arrow", nil)
end

local function clearBestArrow(app)
    app = app or state.controller
    if not app or not app.board then return end
    app.board:setTint("best_arrow", nil); app.board:setArrow("best_arrow", nil)
end

local function clearSecondArrow(app)
    app = app or state.controller
    if not app or not app.board then return end
    app.board:setTint("second_best_arrow", nil); app.board:setArrow("second_best_arrow", nil)
